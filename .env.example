# Copy to .env and fill in. .env is not in git; this file is.

# FOYS
FOYS_USERNAME=
FOYS_PASSWORD=
FOYS_ORGANISATION_ID=
FOYS_ORGANISATION_ID_DEMO=
FOYS_DEMO_MODE=false

# OBS WebSocket (in OBS: Tools > WebSocket Server Settings)
OBS_WEBSOCKET_PASSWORD=
# OBS_WEBSOCKET_HOST=localhost
# OBS_WEBSOCKET_PORT=4455

# Scene control. The defaults are shown; uncomment a line to change it.
# Scene names must match OBS exactly. The status dock warns if one is missing.
# OBS_SCENE_COURT="Scène 2: WIDE Overlay"
# OBS_SCENE_HALFTIME="Scène 4: STATS"
# OBS_SCENE_FINAL="Scène 4: STATS"        # later: "Final Stats"
# OBS_STATS_AFTER_PERIODS=2               # "1,2,3" = every break
# OBS_STATS_DELAY=2.0                     # seconds after the buzzer
